# =================================================================
# THE OWL CLOCK / LOMON — PRODUCTION LIVE SERVER CONFIGURATION
# =================================================================

# 1. SERVER & DOMAIN
# Set PORT if your hosting requires it (defaults to 3000 or provider $PORT)
PORT=3000
# Your public production domain with HTTPS (required for PayPal callbacks & emails)
# Example: https://sonic-archive-ef97.vercel.app
APP_URL=https://sonic-archive-ef97.vercel.app

# 2. PAYPAL LIVE PRODUCTION GATEWAY
# Set PAYPAL_MODE to "live" for real credit card / PayPal transactions.
# Obtain LIVE Client ID and Secret from https://developer.paypal.com -> Apps & Credentials -> Live
# Note: If Live REST keys are not provided or authentication fails, orders automatically route to your official PayPal Hosted Checkout Link.
PAYPAL_MODE=live
PAYPAL_CLIENT_ID=your_live_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_live_paypal_client_secret_here
PAYPAL_HOSTED_PAYMENT_URL=https://www.paypal.com/ncp/payment/EGWC37L2LBCAQ

# 3. DATABASE (MONGODB ATLAS OR SELF-HOSTED)
# Required for persisting users, orders, dynamically executed agreements, and admin edits.
# In MongoDB Atlas, remember to add '0.0.0.0/0' in Network Access -> IP Access List.
# Example: mongodb+srv://clintonharry934_db_user:<password>@cluster0.xsriofy.mongodb.net/theowlclock?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://clintonharry934_db_user:<password>@cluster0.xsriofy.mongodb.net/theowlclock?retryWrites=true&w=majority

# 4. CLOUDFLARE R2 OBJECT STORAGE (S3-COMPATIBLE)
# Used for storing audio masters, stems (ZIPs up to 200MB), PDF contracts, and certificates
R2_BUCKET=owl
R2_REGION=auto
R2_ENDPOINT=https://8d2db169fb0c50093effeb17b495b4ed.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=2b5c17ee83ffc3de26868e41c3a5176f
R2_SECRET_ACCESS_KEY=23cb55de76944f28d611b6fdd3669eaad044539f7368dab2f302e8a7ec089bc9

# 5. RESEND EMAIL SERVICE (SENDING & RECEIVING)
# Obtain your API Key from https://resend.com -> API Keys (starts with re_...)
RESEND_API_KEY=
# From address verified in Resend (e.g. "The Owl Clock <licensing@theowlclock.io>" or "onboarding@resend.dev" for testing)
RESEND_FROM_EMAIL="The Owl Clock" <licensing@theowlclock.io>
# Set to "true" once your domain DNS (MX, SPF, DKIM) is verified in Resend dashboard
RESEND_DOMAIN_VERIFIED=false
# Destination email where all customer transmissions, collaboration proposals, and clearance requests are forwarded
ADMIN_NOTIFICATION_EMAIL=soluwatist@gmail.com
# Dedicated Collaboration routing inbox
COLLABORATION_EMAIL=collaboration@theowlclock.io
# Optional: Resend Inbound Webhook Secret for signature verification
RESEND_WEBHOOK_SECRET=

# 6. GMAIL SMTP BACKUP / FALLBACK (OPTIONAL)
# If Resend key is not set, the server can dispatch via Gmail SMTP using a Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=soluwatist@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="The Owl Clock / LOMON LLC" <licensing@theowlclock.io>
